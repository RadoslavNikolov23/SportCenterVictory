@using SCV.Web.ViewModels.Administration.CrossfitClassesVM
@model IEnumerable<CrossfitClassDeleteVIewModel>

@{
    ViewData["Title"] = "Manage CrossFit Classes (Delete/Restore) ";
}

<h3 class="about_taital text-center pb-4">Manage CrossFit Classes</h3>

<table class="table table-hover text-center align-middle">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Action</th>
            <th>Option</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var classVm in Model)
        {
            <tr class="@(classVm.IsActive ? "" : "table-warning")">
                <td>@classVm.Name</td>
                <td>
                    @if (classVm.IsActive)
                    {
                        <span class="badge bg-success text-white">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary text-white">Inactive</span>
                    }
                </td>
                <td>
                    <a asp-action="ToggleDelete"
                       asp-route-id="@classVm.Id"
                       class="btn @(classVm.IsActive ? "btn-danger" : "btn-warning") btn-sm fw-bold">
                        <i class="bi @(classVm.IsActive ? "bi-trash" : "bi-arrow-clockwise")"></i>
                        @(classVm.IsActive ? "Delete" : "Restore")
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
