<h3 class="about_taital text-center pt-5 pb-5">Memberships & Client Overview</h3>

@foreach (var userCrossfitClasses in groupedUserCrossfitClasses)
{
    <div class="card specialty-card">
        <div class="specialty-header">
            <h4 class="mb-0 text-white text-center">Week Day - @userCrossfitClasses.Key.ToString()</h4>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover specialty-table mb-0">
                <thead>
                    <tr>
                        <th>Crossfit Class Name</th>
                        <th>Crossfit Class Trainer Name</th>
                        <th>Client FullName</th>
                        <th>Client Email</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in userCrossfitClasses)
                    {
                        <tr>
                            <td>@item.CrossfitClassName</td>
                            <td>@item.CrossfitClassTrainerName</td>
                            <td>@item.ClientFullName</td>
                            <td><a href="mailto:@item.ClientEmail">@item.ClientEmail</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Styles {
    <link href="~/css/admin/userCrossfitcCass.css" rel="stylesheet" />
}
