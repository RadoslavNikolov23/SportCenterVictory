@using SCV.Web.ViewModels.Administration.ReferenceVM
@model IEnumerable<UserCrossfitClassesForAdminListViewModel>

@{
    ViewData["Title"] = "CrossFit Classes & Users Overview";
    var groupedUserCrossfitClasses = Model
        .GroupBy(m => m.DayOfWeek);
}

<h3 class="about_taital text-center pt-5 pb-5">CrossFit Classes & Client Overview</h3>

@if (Model == null || !Model.Any())
{
    <div class="text-center" style="padding-top: 180px;">
        <p class="text-center fs-4" style="font-size: 1.5rem;">
            No members has joined any CrossFit Classes yet. Please check back later.
        </p>
    </div>

}
else
{
    @foreach (var userCrossfitClasses in groupedUserCrossfitClasses)
    {
        <div class="card specialty-card">
            <div class="specialty-header">
                <h4 class="mb-0 text-white text-center">Week Day - @userCrossfitClasses.Key.ToString()</h4>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover specialty-table mb-0">
                    <thead>
                        <tr>
                            <th>Crossfit Class Name</th>
                            <th>Crossfit Class Trainer Name</th>
                            <th>Client FullName</th>
                            <th>Client Email</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in userCrossfitClasses)
                        {
                            <tr>
                                <td>@item.CrossfitClassName</td>
                                <td>@item.CrossfitClassTrainerName</td>
                                <td>@item.ClientFullName</td>
                                <td><a href="mailto:@item.ClientEmail">@item.ClientEmail</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
@section Styles {
    <link href="~/css/admin/userCrossfitcCass.css" rel="stylesheet" />
}
