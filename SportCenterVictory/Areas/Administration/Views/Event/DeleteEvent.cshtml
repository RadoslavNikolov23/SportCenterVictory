@using SCV.Web.ViewModels.Administration.EventVM
@model IEnumerable<EventDeleteViewModel>

@{
    ViewData["Title"] = "Manage Events (Delete/Restore) ";
}

<h3 class="about_taital text-center pb-4">Manage All Events</h3>

<table class="table table-hover text-center align-middle">
    <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Event Type</th>
            <th>Action</th>
            <th>Option</th>
        </tr>
    </thead>
    <tbody>
        @foreach (EventDeleteViewModel eventVm in Model)
        {
            <tr class="@(!eventVm.IsDeleted ? "" : "table-warning")">
                <td>@eventVm.Title</td>
                <td>@eventVm.EventType</td>
                <td>
                    @if (!eventVm.IsDeleted)
                    {
                        <span class="badge bg-success text-white">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary text-white">Deleted</span>
                    }
                </td>
                <td>
                    <a asp-action="ToggleDelete"
                       asp-route-id="@eventVm.Id"
                       class="btn @(eventVm.IsDeleted ? "btn-danger" : "btn-warning") btn-sm fw-bold">
                        <i class="bi @(!eventVm.IsDeleted ? "bi-trash" : "bi-arrow-clockwise")"></i>
                        @(!eventVm.IsDeleted ? "Delete" : "Restore")
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
