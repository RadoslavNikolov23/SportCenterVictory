@using SCV.Web.ViewModels.Administration.EventVM
@model EventAddViewModel

@{
    ViewData["Title"] = "Add Event";
}

<h1 class="about_taital text-center pd-5">Add New Event</h1>

<div class="row pt-3">
    <div class="col-sm-12 offset-lg-2 col-lg-8 offset-xl-3 col-xl-6">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <form asp-action="AddEvent" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-2">
                <label asp-for="Title" class="form-label-add-edit">Title</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-2">
                <label asp-for="EventType" class="form-label fw-bold">Event Type</label>
                <div class="input-group">
                    <select asp-for="EventType" class="form-select w-100"
                            asp-items="Html.GetEnumSelectList<SCV.GlCommon.Enums.SportType>()">
                        <option value="">Select Type</option>
                    </select>
                <span asp-validation-for="EventType" class="text-danger"></span>
                </div>
            </div>



            <div class="mb-2">
                <label asp-for="StartDate" class="form-label-add-edit">Start Date</label>
                <input asp-for="StartDate" type="datetime-local" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <div class="mb-2">
                <label asp-for="Location" class="form-label-add-edit">Location</label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>

            <div class="mb-2">
                <label asp-for="ImageUrl" class="form-label-add-edit">Image URL</label>
                <input asp-for="ImageUrl" class="form-control" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>

            <div class="mb-2">
                <label asp-for="Description" class="form-label-add-edit">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-2">
                <button class="btn btn-warning btn-dark-text w-100 py-2 fw-bold rounded" type="submit">
                    Create Event
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
