@using SCV.Web.ViewModels.Administration.ReferenceVM
@model IEnumerable<EventsUserForAdminListViewModel>

@{
    ViewData["Title"] = "Events-Users Overview";
    var groupedEventUsers= Model
        .GroupBy(m => m.EventType);
}

<h3 class="about_taital text-center pt-5 pb-5">Events & Users Overview</h3>

@foreach (var eventUsers in groupedEventUsers)
{
    <div class="card specialty-card">
        <div class="specialty-header">
            <h4 class="mb-0 text-white text-center">@eventUsers.Key.ToString() Event</h4>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover specialty-table mb-0">
                <thead>
                    <tr>
                        <th>Event Title</th>
                        <th>Event StartDate</th>
                        <th>Event Location</th>
                        <th>Client Full Name</th>
                        <th>Client Email</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var first = eventUsers.First();
                        bool firstRow = true;
                    }

                    @foreach (var item in eventUsers)
                    {
                        <tr>
                            @if (firstRow)
                            {
                                <td rowspan="@eventUsers.Count()">@first.EventTitle</td>
                                <td rowspan="@eventUsers.Count()">@first.EventStartDate</td>
                                <td rowspan="@eventUsers.Count()">@first.EventLocation</td>
                                firstRow = false;
                            }

                            <td>@item.ClientFullName</td>
                            <td><a href="mailto:@item.ClientEmail">@item.ClientEmail</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Styles {
    <link href="~/css/admin/eventClient.css" rel="stylesheet" />
}

