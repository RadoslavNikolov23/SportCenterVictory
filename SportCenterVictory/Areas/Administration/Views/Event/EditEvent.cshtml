@using SCV.Web.ViewModels.Administration.EventVM
@model IEnumerable<EventAdminDetailViewModel>

@{
    ViewData["Title"] = "Edit Event ";
}

<h1 class="about_taital text-center">Edit Event</h1>

<div class="row pt-3">
    <div class="col-sm-12 offset-lg-2 col-lg-8 offset-xl-3 col-xl-6">

        <label for="eventSelect">Search & Select an Event</label>
        <input class="form-control mb-2" list="eventOptions" id="eventSearchInput" placeholder="Type event title..." />
        <datalist id="eventOptions">
            @foreach (var ev in Model)
            {
                <option value="@ev.Title" data-id="@ev.Id"></option>
            }
        </datalist>

        <button class="btn btn-primary mb-4" id="loadEventBtn">Load Event</button>

        <form id="editEventForm" asp-action="EditEvent" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" id="Id" name="Id" />

            <div class="row">
                <div class="col-sm-6 mb-2">
                    <label for="Title">Event Title</label>
                    <input class="form-control" id="Title" name="Title" />
                </div>

                <div class="col-sm-6 mb-2">
                    <label for="Location">Location</label>
                    <input class="form-control" id="Location" name="Location" />
                </div>
            </div>

            <div class="mb-2">
                <label for="Description">Description</label>
                <textarea class="form-control" id="Description" name="Description" rows="3"></textarea>
            </div>

            <div class="row">
                <div class="col-sm-6 mb-2">
                    <label for="StartDate">Start Date</label>
                    <input type="datetime-local" class="form-control" id="StartDate" name="StartDate" />
                </div>

                <div class="col-sm-6 mb-2">
                    <label for="EventType" class="form-label fw-bold">Event Type</label>
                    <select id="EventType" name="EventType" class="form-control w-100">
                        <option value="">Select an event type</option>
                        @foreach (var type in Html.GetEnumSelectList<SCV.GlCommon.Enums.SportType>())
                        {
                            var value = (int)Enum.Parse(typeof(SCV.GlCommon.Enums.SportType), type.Value.ToString());
                            <option value="@value">@type.Text</option>
                        }
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label for="ImageUrl">Image URL</label>
                <input class="form-control" id="ImageUrl" name="ImageUrl" />
            </div>

            <div class="mb-2">
                <button type="submit" class="btn btn-warning w-100">Update Event</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const events = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

    </script>
    <script src="~/js/admin/event-edit.js"></script>
}

