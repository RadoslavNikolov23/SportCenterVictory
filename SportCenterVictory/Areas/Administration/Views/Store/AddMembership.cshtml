@using SCV.Web.ViewModels.Administration.StoreVM.MembershipsVM
@model MembershipAddViewModel

@{
    ViewData["Title"] = "Add Membership ";
}

<h2 class="about_taital text-center pd-5">Add New Membership</h2>

<div class="row pt-3">
    <div class="col-sm-12 offset-lg-2 col-lg-8 offset-xl-3 col-xl-6">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <form asp-action="AddMembership" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-2">
                    <label asp-for="Name" class="form-label-add-edit">Name</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            <div class="row">
                <div class="col-md-6 mb-2">
                    <label asp-for="Price" class="form-label-add-edit">Price</label>
                    <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-2">
                    <label asp-for="MembershipType" class="form-label fw-bold">Membership Type</label>
                    <div class="input-group">
                        <select asp-for="MembershipType" class="form-select w-100"
                                asp-items="Html.GetEnumSelectList<SCV.GlCommon.Enums.SportType>()">
                            <option value="">Select Type</option>
                        </select>
                    </div>
                    <span asp-validation-for="MembershipType" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-2">
                    <label asp-for="DurationText" class="form-label-add-edit">Duration in Text</label>
                    <input asp-for="DurationText" class="form-control" />
                    <span asp-validation-for="DurationText" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-2">
                    <label asp-for="Duration" class="form-label-add-edit">Duration in Days</label>
                    <input asp-for="Duration" class="form-control" type="number" step="1" min="0" />
                    <span asp-validation-for="Duration" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-2">
                <label asp-for="Description" class="form-label-add-edit">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-2">
                <button class="btn btn-warning btn-dark-text w-100 py-2 fw-bold rounded" type="submit">
                    Add Membership
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
