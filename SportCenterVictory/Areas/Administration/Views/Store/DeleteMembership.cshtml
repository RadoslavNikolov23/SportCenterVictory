@using SCV.Web.ViewModels.Administration.StoreVM.MembershipsVM
@model IEnumerable<MembershipDeleteViewModel>

@{
    ViewData["Title"] = "Manage Memberships (Delete/Restore) ";
}

<h3 class="about_taital text-center pb-4">Manage All Memberships</h3>

<table class="table table-hover text-center align-middle">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Membership Type</th>
            <th>Action</th>
            <th>Option</th>
        </tr>
    </thead>
    <tbody>
        @foreach (MembershipDeleteViewModel membershipVm in Model)
        {
            <tr class="@(!membershipVm.IsDeleted ? "" : "table-warning")">
                <td>@membershipVm.Name</td>
                <td>@membershipVm.MembershipType</td>
                <td>
                    @if (!membershipVm.IsDeleted)
                    {
                        <span class="badge bg-success text-white">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary text-white">Deleted</span>
                    }
                </td>
                <td>
                    <a asp-action="ToggleDeleteMembership"
                       asp-route-id="@membershipVm.Id"
                       class="btn @(membershipVm.IsDeleted ? "btn-danger" : "btn-warning") btn-sm fw-bold">
                        <i class="bi @(!membershipVm.IsDeleted ? "bi-trash" : "bi-arrow-clockwise")"></i>
                        @(!membershipVm.IsDeleted ? "Delete" : "Restore")
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
