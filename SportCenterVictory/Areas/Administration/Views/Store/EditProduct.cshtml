@using SCV.Web.ViewModels.Administration.StoreVM.ProductsVM
@model IEnumerable<ProductAdminDetailViewModel>

@{
    ViewData["Title"] = "Edit Product ";
}

<h1 class="about_taital text-center">Edit Product</h1>

<div class="row pt-3">
    <div class="col-sm-12 offset-lg-2 col-lg-8 offset-xl-3 col-xl-6">

        <label for="productSelect">Search & Select an Product</label>
        <input class="form-control mb-2" list="productOptions" id="productSearchInput" placeholder="Type product title..." />
        <datalist id="productOptions">
            @foreach (ProductAdminDetailViewModel product in Model)
            {
                <option value="@product.Title" data-id="@product.Id"></option>
            }
        </datalist>

        <button class="btn btn-primary mb-4" id="loadProductBtn">Load Product</button>

        <form id="editProductForm" asp-action="EditProduct" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" id="Id" name="Id" />

            <div class="row">
                <div class="col-sm-6 mb-2">
                    <label for="Title">Product Title</label>
                    <input class="form-control" id="Title" name="Title" />
                </div>

                <div class="col-sm-6 mb-2">
                    <label for="ProductCategory" class="form-label fw-bold">Product Category</label>
                    <select id="ProductCategory" name="ProductCategory" class="form-control w-75">
                        <option value="">Select a product type</option>
                        @foreach (var type in Html.GetEnumSelectList<SCV.GlCommon.Enums.ProductCategory>())
                        {
                            var value = (int)Enum.Parse(typeof(SCV.GlCommon.Enums.ProductCategory), type.Value.ToString());
                            <option value="@value">@type.Text</option>
                        }
                    </select>
                </div>
            </div>

            <div class="mb-2">
                <label for="Description">Description</label>
                <textarea class="form-control" id="Description" name="Description" rows="3"></textarea>
            </div>

            <div class="row">
                <div class="col-sm-6 mb-2">
                    <label for="Quantity">Quantity</label>
                    <input type="number" step="1" min="0" class="form-control" id="Quantity" name="Quantity" />
                </div>

                <div class="col-sm-6 mb-2">
                    <label for="Price">Price</label>
                    <input type="number" step="0.01" min="0" class="form-control" id="Price" name="Price" />
                </div>

            </div>

            <div class="mb-3">
                <label for="ImageUrl">Image URL</label>
                <input class="form-control" id="ImageUrl" name="ImageUrl" />
            </div>

            <div class="mb-2">
                <button type="submit" class="btn btn-warning w-100">Update Product</button>
            </div>
        </form>
    </div>
</div>



@section Scripts {
    <script>
        const products = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

    </script>
    <script src="~/js/admin/product-edit.js"></script>
}
