@using SCV.Web.ViewModels.Administration.FitnessVM
@model ExerciseDeletePageViewModel

@{
    ViewData["Title"] = "Manage Exercises (Delete/Restore) ";
}

<h3 class="about_taital text-center pb-4 pt-4">Manage All Exercises</h3>

<div class="mb-3 text-center w-50 mx-auto">
    <div class="input-group">
        <input id="searchInput" type="text" class="form-control" placeholder="Search exercises by name..." />
        <button id="searchBtn" class="btn btn-primary ml-1" type="button">Search</button>
    </div>
</div>

<div id="exerciseTableContainer" class="pt-4 pb-4">
    @await Html.PartialAsync("_ExerciseDeleteTablePartial", Model)
</div>

@section Scripts {

    <script src="~/js/admin/exercise-delete.js"></script>
}
