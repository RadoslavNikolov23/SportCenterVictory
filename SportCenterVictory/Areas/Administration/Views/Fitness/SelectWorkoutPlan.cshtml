@using SCV.Web.ViewModels.Administration.FitnessVM
@model WorkoutPlanSelectListViewModel

@{
    ViewData["Title"] = "Select Workout Plan ";
}

<h3 class="about_taital text-center pb-5 pt-5">Select a Workout Plan to Attach Exercises</h3>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var plan in Model.WorkoutPlans)
    {
        <div class="col mb-4 pt-3">
            <div class="card h-100 shadow border-dark p-3 w-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <h3 class="card-title fw-bold text-dark-emphasis text-center">@plan.Title</h3>

                    <div class="mt-auto text-end text-center">
                        <a class="btn btn-outline-dark btn-lg"
                           asp-area="Administration"
                           asp-controller="Fitness"
                           asp-action="AttachExercises"
                           asp-route-id="@plan.Id">
                            Attach Exercises
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
