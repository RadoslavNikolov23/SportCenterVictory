@using SCV.Web.ViewModels.Administration.FitnessVM
@model WorkoutPlanExerciseAttachViewModel

@{
    ViewData["Title"] = "Attach Exercises to Workout Plan ";
}

<h2 class="about_taital text-center pb-5 pt-5">Attach Exercises to: @Model.WorkoutPlanTitle</h2>

<form asp-action="AttachExercises" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="WorkoutPlanId" />

    @* <div class="mb-3 text-center">
        <input type="text" id="exerciseSearch" class="form-control" placeholder="Search exercises..." />
    </div> *@

    <div class="mb-8 text-center">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <select id="exerciseSelect" class="form-select" style="width: 85%; font-size: 1.0rem; height: 2.5rem;">
                    <option value="">-- Select an exercise --</option>
                    @foreach (var exercise in Model.AllExercises)
                    {
                        <option value="@exercise.Id">@exercise.Name</option>
                    }
                </select>
            </div>
        </div>
        <button type="button" id="attachExerciseBtn" class="btn btn-outline-primary mt-3 px-4 py-2" >
            Attach
        </button>
    </div>

    <ul id="attachedExercisesList" class="list-group mb-3 pt-4">
        @foreach (var attachedId in Model.AttachedExerciseIds)
        {
            var name = Model.AllExercises.FirstOrDefault(e => e.Id == attachedId)?.Name ?? "(Unknown)";
            <li id="li_@attachedId" class="list-group-item d-flex justify-content-between align-items-center">
                @name
                <button type="button" class="btn btn-sm btn-danger" onclick="removeExercise('@attachedId')">Remove</button>
                <input type="hidden" name="SelectedExerciseIds" value="@attachedId" id="input_@attachedId" />
            </li>
        }
    </ul>

    <div class="text-center">
        <button type="submit" class="btn btn-success item" style="width: 250px; height: 50px;">Save Attachments</button>
    </div>
</form>


@section Scripts {
    <script src="~/js/admin/attach-exercise.js"></script>
}

