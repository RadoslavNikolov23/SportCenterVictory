@using SCV.Web.ViewModels.Administration.FitnessVM
@model ExerciseDeletePageViewModel

@{
    int maxPageLinks = 7;
    int startPage = Math.Max(Model.CurrentPage - maxPageLinks / 2, 1);
    int endPage = startPage + maxPageLinks - 1;

    if (endPage > Model.TotalPages)
    {
        endPage = Model.TotalPages;
        startPage = Math.Max(endPage - maxPageLinks + 1, 1);
    }
}


<table id="exerciseTable" class="table table-hover text-center align-middle">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Primary Muscles</th>
            <th>Category</th>
            <th>Action</th>
            <th>Option</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var exerciseVm in Model.Exercises)
        {
            <tr class="@(!exerciseVm.IsDeleted ? "" : "table-warning")">
                <td>@exerciseVm.Name</td>
                <td>@exerciseVm.PrimaryMuscles</td>
                <td>@exerciseVm.Category</td>
                <td>
                    @if (!exerciseVm.IsDeleted)
                    {
                        <span class="badge bg-success text-white">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary text-white">Deleted</span>
                    }
                </td>
                <td>
                    <a asp-action="ToggleDeleteExercise"
                       asp-route-id="@exerciseVm.Id"
                       class="btn @(exerciseVm.IsDeleted ? "btn-danger" : "btn-warning") btn-sm fw-bold">
                        <i class="bi @(!exerciseVm.IsDeleted ? "bi-trash" : "bi-arrow-clockwise")"></i>
                        @(!exerciseVm.IsDeleted ? "Delete" : "Restore")
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>


<nav aria-label="Page navigation" class="text-center">
    <ul class="pagination justify-content-center">
        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
            <a class="page-link" href="?page=@(Model.CurrentPage - 1)&searchTerm=@Model.SearchTerm">Previous</a>
        </li>

        @* Show first page and leading ellipsis if needed *@
        @if (startPage > 1)
        {
            <li class="page-item">
                <a class="page-link" href="?page=1&searchTerm=@Model.SearchTerm">1</a>
            </li>
            @if (startPage > 2)
            {
                <li class="page-item disabled"><span class="page-link">...</span></li>
            }
        }

        @* Page links in the window *@
        @for (int i = startPage; i <= endPage; i++)
        {
            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                <a class="page-link" href="?page=@i&searchTerm=@Model.SearchTerm">@i</a>
            </li>
        }

        @* Trailing ellipsis and last page if needed *@
        @if (endPage < Model.TotalPages)
        {
            if (endPage < Model.TotalPages - 1)
            {
                <li class="page-item disabled"><span class="page-link">...</span></li>
            }
            <li class="page-item">
                <a class="page-link" href="?page=@Model.TotalPages&searchTerm=@Model.SearchTerm">@Model.TotalPages</a>
            </li>
        }

        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
            <a class="page-link" href="?page=@(Model.CurrentPage + 1)&searchTerm=@Model.SearchTerm">Next</a>
        </li>
    </ul>
</nav>