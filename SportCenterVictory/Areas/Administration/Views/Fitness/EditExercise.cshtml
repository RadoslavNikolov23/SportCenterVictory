@using SCV.Web.ViewModels.Administration.FitnessVM
@model IEnumerable<ExerciseAdminDetailViewModel>

@{
    ViewData["Title"] = "Edit Exercise ";
}

<h1 class="about_taital text-center">Edit Exercise</h1>

<div class="row pt-3">
    <div class="col-sm-12 offset-lg-2 col-lg-8 offset-xl-3 col-xl-6">

        <label for="exerciseSelect">Search & Select an Exercise</label>
        <input class="form-control mb-2" list="exerciseOptions" id="exerciseSearchInput" placeholder="Type exercise name..." />
        <datalist id="exerciseOptions">

            @foreach (ExerciseAdminDetailViewModel exercise in Model)
            {
                <option value="@exercise.Name" data-id="@exercise.Id"></option>
            }
        </datalist>

        <button class="btn btn-primary mb-4" id="loadExerciseBtn">Load Exercise</button>

        <form id="editExerciseForm" asp-action="EditExercise" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" id="Id" name="Id" />

            <div class="row">
                <div class="col-sm-6 mb-2">
                    <label for="Name">Exercise Name</label>
                    <input class="form-control" id="Name" name="Name" />
                </div>
            </div>

            <div class="row">
                <div class="col-sm-6 mb-2">
                    <label for="Force">Force</label>
                    <input class="form-control" id="Force" name="Force" />
                </div>
                <div class="col-sm-6 mb-2">
                    <label for="Category">Category</label>
                    <input class="form-control" id="Category" name="Category" />
                </div>
            </div>

            <div class="row">
                <div class="col-sm-6 mb-2">
                    <label for="Equipment">Equipment</label>
                    <input class="form-control" id="Equipment" name="Equipment" />
                </div>
                <div class="col-sm-6 mb-2">
                    <label for="Mechanic">Mechanic</label>
                    <input class="form-control" id="Mechanic" name="Mechanic" />
                </div>
            </div>

            <div class="row">
                <div class="col-sm-6 mb-2">
                    <label for="PrimaryMuscles">Primary Muscles</label>
                    <input class="form-control" id="PrimaryMuscles" name="PrimaryMuscles" />
                </div>
                <div class="col-sm-6 mb-2">
                    <label for="SecondaryMuscles">Secondary Muscles</label>
                    <input class="form-control" id="SecondaryMuscles" name="SecondaryMuscles" />
                </div>
            </div>

            <div class="mb-2">
                <label for="Instructions">Instructions</label>
                <textarea class="form-control" id="Instructions" name="Instructions" rows="8"></textarea>
            </div>

            <div class="row">
                <div class="col-sm-6 mb-2">
                    <label for="ImageUrlOne">ImageUrl One Exercise</label>
                    <input class="form-control" id="ImageUrlOne" name="ImageUrlOne" />
                </div>
            </div>

            <div class="row">
                <div class="col-sm-6 mb-2">
                    <label for="ImageUrlTwo">ImageUrl Two Exercise</label>
                    <input class="form-control" id="ImageUrlTwo" name="ImageUrlTwo" />
                </div>
            </div>

            <div class="mb-2">
                <button type="submit" class="btn btn-warning w-100">Update Exercise</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const exercises = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

    </script>
    <script src="~/js/admin/exercise-edit.js"></script>
}