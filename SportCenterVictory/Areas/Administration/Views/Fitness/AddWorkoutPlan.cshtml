@using SCV.Web.ViewModels.Administration.FitnessVM
@model WorkoutPlanAddViewModel

@{
    ViewData["Title"] = "Add Workout Plan ";
}

<h2 class="about_taital text-center pd-5">Add New Workout Plan</h2>

<div class="row pt-3">
    <div class="col-sm-12 offset-lg-2 col-lg-8 offset-xl-3 col-xl-6">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <form asp-action="AddWorkoutPlan" method="post">
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-6 mb-2">
                    <label asp-for="Title" class="form-label-add-edit">Title</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-2">
                    <label asp-for="Type" class="form-label-add-edit">Sport Type</label>
                    <select asp-for="Type" class="form-control"
                            asp-items="Html.GetEnumSelectList<SCV.GlCommon.Enums.SportType>()">
                        <option value="">Select Type</option>
                    </select>
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-2">
                <label asp-for="Description" class="form-label-add-edit">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-2">
                <label asp-for="ImageUrl" class="form-label-add-edit">Image URL</label>
                <input asp-for="ImageUrl" class="form-control" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>

            <div class="mb-2">
                <button class="btn btn-warning btn-dark-text w-100 py-2 fw-bold rounded" type="submit">
                    Add Workout Plan
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}