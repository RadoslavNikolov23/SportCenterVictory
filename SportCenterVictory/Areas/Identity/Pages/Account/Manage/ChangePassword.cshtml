@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3 class="about_taital text-center fw-bold pt-5 pb-5">@ViewData["Title"]</h3>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row justify-content-center mt-4 pb-5">
    <div class="col-md-6">
        <div class="card shadow-lg border-0 rounded-3">
            <div class="card-body p-4">
                <form id="change-password-form" method="post">
                    <div asp-validation-summary="All" class="text-danger text-center"></div>

                    <div class="mb-3">
                        <label asp-for="Input.OldPassword" class="form-label fw-bold text-center d-block"></label>
                        <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Input.OldPassword" class="text-danger d-block text-center mt-1"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.NewPassword" class="form-label fw-bold text-center d-block"></label>
                        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Input.NewPassword" class="text-danger d-block text-center mt-1"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.ConfirmPassword" class="form-label fw-bold text-center d-block"></label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger d-block text-center mt-1"></span>
                    </div>

                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-primary px-4">Update password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
