@{
    ViewData["Title"] = "CrossFit Center";
}

<div class="about_section pt-3">
    <div class="container">
        <div class="row">
            <div class="col-md-12">

                <div class="about_taital text-center">🔥 CROSSFIT ARENA</div>

                <div class="row mb-4 pt-4">
                    <div class="col-md-6 pb-1">
                        <img src="https://dl.dropboxusercontent.com/scl/fi/cl689h1pgw0nmr8n0thj8/crossfitcenter1.jpg?rlkey=gwvtopsghg12plu2zxqe170uz&st=8grgbpqw" class="d-block w-100 rounded shadow" alt="CrossFit Arena1">
                    </div>
                    <br />
                    <div class="col-md-6">
                        <img src="https://dl.dropboxusercontent.com/scl/fi/z0alyi8lwlhl4srcl3wqa/crossfitcenter2.jpg?rlkey=00w9v8d50g1yi0wtedyo2tb0w&st=ln3dhl08" class="d-block w-100 rounded shadow" alt="CrossFit Arena3">
                    </div>
                </div>

                <p class="about_text text-center pt-1">
                    Welcome to our high-energy <strong>CrossFit Arena</strong>, where community, challenge, and results collide. We host structured group workouts for all levels.
                    Whether you're a beginner or seasoned athlete, our CrossFit program is built to push your limits safely and effectively.
                    <br><br>
                    We provide:
                    <ul class="list-group list-group-flush text-center mx-auto" style="max-width: 600px;">
                        <li class="list-group-item">🔥 Daily WODs (Workouts of the Day)</li>
                        <li class="list-group-item">👟 Group Class Schedules</li>
                        <li class="list-group-item">🏋️ Certified CrossFit Coaches</li>
                        <li class="list-group-item">🎯 Competitive Events & Challenges</li>
                    </ul>
                    <br>
                </p>
            </div>
        </div>
    </div>
</div>
