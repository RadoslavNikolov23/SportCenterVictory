@using SCV.Web.ViewModels.CrossfitVM
@using SCV.GlCommon;
@model IEnumerable<CrossfitClassDetailViewModel>
@{
    ViewData["Title"] = "CrossFit Classes ";
}

<h2 class="about_taital text-center pt-4">Join our CrossFit Classes</h2>

<div class="classes-board">
    @foreach (var crossfitClass in Model)
    {
        <div class="class-card">
            <div class="class-title">@crossfitClass.Name</div>

            <div class="class-info"><strong>Trainer:</strong> @crossfitClass.TrainerName</div>
            <div class="class-info"><strong>Start Time:</strong> @crossfitClass.StartTime</div>

            <div class="class-description">@crossfitClass.Description</div>

            @if ((User?.Identity?.IsAuthenticated ?? false) && User.IsInRole(RoleConstants.User))
            {
                @if (crossfitClass.IsUserJoined)
                {
                    <form asp-controller="UserPanel" asp-action="RemoveCrossfitClass" method="post" class="d-inline">
                        <input type="hidden" name="crossfitClassId" value="@crossfitClass.CrossfitClassId" />
                        <button type="submit" class="remove-button">
                            <i class="bi bi-file-x"></i> Remove Class
                        </button>
                    </form>
                }
                else
                {
                    <form asp-controller="UserPanel" asp-action="JoinCrossfitClass" method="post" class="d-inline">
                        <input type="hidden" name="crossfitClassId" value="@crossfitClass.CrossfitClassId" />
                        <button type="submit" class="join-button">
                            <i class="bi bi-bookmark-star"></i> Join Class
                        </button>
                    </form>
                }
            }
        </div>
    }
</div>

@section Styles {
    <link href="~/css/crossfitClass.css" rel="stylesheet" />
}
