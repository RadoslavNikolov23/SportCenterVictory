@using SCV.Web.ViewModels.CommonVM
@model IEnumerable<UserFeedbackDetailViewModel>


<!-- banner section start -->
<div class="banner_section layout_padding">
    <div class="container">
        <div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel" data-interval="3000">
            <ol class="carousel-indicators">
                <li data-target="#carouselExampleIndicators" data-slide-to="0" class="active"></li>
                <li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
                <li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
            </ol>
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <div class="row">
                        <div class="col-sm-12">
                            <h1 class="banner_taital">Sport Center Victory</h1>
                            <p class="banner_text">"Your Journey. Your Rules. Your Victory."</p>
                            <div class="btn_main">
                                <div class="started_bt"><a asp-controller="About" asp-action="Index">About Us</a></div>
                                <div class="started_bt" active><a asp-controller="Contact" asp-action="Index">Contact Us</a></div>
                            </div>
                        </div>
                    </div>
                </div>
                @* Change the content of the carousel items as needed to a trainers menu  *@
                <div class="carousel-item">
                    <div class="row">
                        <div class="col-sm-12">
                            <h1 class="banner_taital">Choose your Journey</h1>
                            <p class="banner_text">From Fitness, to Crossfit, to Powerlifting</p>
                            <div class="btn_main">
                                <div class="started_bt" active><a asp-controller="Fitness" asp-action="FitnessCenter">Fitness</a></div>
                                <div class="started_bt"><a asp-controller="CrossFit" asp-action="CrossFitCenter">CrossFit</a></div>
                                <div class="started_bt" active><a asp-controller="Powerlifting" asp-action="PowerliftingCenter">Powerlifting</a></div>

                            </div>
                        </div>
                    </div> 
                </div>
                <div class="carousel-item">
                    <div class="row">
                        <div class="col-sm-12">
                            <h1 class="banner_taital">Visit our Store and get Started</h1>
                            <p class="banner_text">Get all the lates equipment and products</p>
                            <div class="btn_main">
                                <div class="started_bt"><a asp-controller="Store" asp-action="Equipment">Equipment</a> </div>
                                <div class="started_bt" active><a asp-controller="Store" asp-action="Nutrition">Nutrition</a> </div>
                                <div class="started_bt"><a asp-controller="Store" asp-action="Memberships">Memberships</a> </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- banner section end -->

<!-- about section start -->
<div class="container py-5 d-flex justify-content-center">
    <div class="bg-white rounded-4 shadow-lg p-5 text-center">
        <h1 class="display-5 fw-bold text-success mb-3">
            🏆 Welcome to <span class="text-dark">Sport Center Victory</span>
        </h1>
        <p class="lead text-muted mb-4">
            Established in 2025 in Ruse, Bulgaria — your ultimate destination for Fitness, CrossFit, Powerlifting, expert trainers, and thrilling events.
        </p>
        <a asp-controller="About" asp-action="Index" class="btn btn-outline-success btn-lg px-5 py-2 shadow-sm rounded-pill">
            Learn More About Us →
        </a>
    </div>
</div>
<!-- about section end -->

<!-- games section start -->
<div class="games_section">
    <div class="container">
        <div class="row">
            <div class="col-sm-12">
                <h1 class="games_taital">Our areas await you, Choose from where to Start</h1>
                <p class="games_text">The resistance that you fight physically in the gym and the resistance that you fight in life can only build a strong character. - <i>A. Schwarzenegger</i></p>
            </div>
        </div>
        <div class="games_section_2">
            <div class="row">
                <div class="col-lg-4">
                    <div class="hover01 column">
                        <figure><img src="~/images/Main/game01.jpg"></figure>
                    </div>
                    <h3 class="basketball_text">Fitness</h3>
                    <p class="lorem_text">Build Your Best Self. Step into our Fitness Center and take control of your transformation. With expert trainers, personalized programs, and top-tier equipment — your goals become your results.</p>
                    <div class="readmore_bt"><a asp-controller="Fitness" asp-action="FitnessMembership">Memberships</a></div>
                </div>
                <div class="col-lg-4">
                    <div class="hover01 column">
                        <figure><img src="~/images/Main/game02.jpg"></figure>
                    </div>
                    <h3 class="basketball_text">Crossfit</h3>
                    <p class="lorem_text">Train for the Unexpected. Challenge yourself with high-intensity CrossFit workouts, daily WODs, and a strong community. Every session is designed to build functional strength, endurance, and mental toughness.</p>
                    <div class="readmore_bt"><a asp-controller="CrossFit" asp-action="CrossFitMembership">Memberships</a></div>
                </div>
                <div class="col-lg-4">
                    <div class="hover01 column">
                        <figure><img src="~/images/Main/game03.jpg"></figure>
                    </div>
                    <h3 class="basketball_text">Powerlifting</h3>
                    <p class="lorem_text">Lift Heavy. Live Strong. Our Powerlifting Zone is built for strength athletes. From squats to deadlifts, train with precision under the guidance of expert coaches and hit your next PR.</p>
                    <div class="readmore_bt"><a asp-controller="Powerlifting" asp-action="PowerliftingMembership">Memberships</a></div>
                
                </div>
            </div>
        </div>
    </div>
</div>
<!-- games section end -->
<!-- blog section start -->
