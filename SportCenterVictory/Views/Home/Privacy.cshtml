@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="privacy-section py-5 bg-dark text-white">
    <div class="container pt-5">
        <div class="card shadow-lg border-0 rounded-4 bg-white text-dark p-4">
            <div class="card-body">
                <h1 class="display-5 fw-bold text-center mb-4 text-primary">🔒 Privacy Policy</h1>

                <p class="lead text-center mb-5">
                    This Privacy Policy outlines how <strong>Sport Center Victory</strong> collects, uses, and protects your personal information.
                </p>

                <h4>1. Information We Collect</h4>
                <p>We may collect your name, email address, phone number, and health-related preferences when you:</p>
                <ul class="list-group list-group-flush mb-4">
                    <li class="list-group-item">✅ Register for memberships or classes (Fitness, CrossFit, Powerlifting)</li>
                    <li class="list-group-item">✅ Purchase products from our online store</li>
                    <li class="list-group-item">✅ Interact with trainers or coaches</li>
                </ul>

                <h4>2. How We Use Your Data</h4>
                <p>We use your data to:</p>
                <ul class="list-group list-group-flush mb-4">
                    <li class="list-group-item">💪 Provide custom workout or nutrition plans</li>
                    <li class="list-group-item">📝 Manage your membership and bookings</li>
                    <li class="list-group-item">📈 Improve your Sport Center experience</li>
                </ul>

                <h4>3. Data Protection</h4>
                <p>We use encryption and secure storage. Access is limited to authorized staff only.</p>

                <h4>4. Sharing of Information</h4>
                <p>We only share data with trusted partners like payment providers. No selling or renting your data.</p>

                <h4>5. Your Rights</h4>
                <p>
                    You may access, update, or delete your personal data anytime. Contact us at
                    <a href="mailto:custom_rd@abv.bg"><i>custom_rd@abv.bg</i></a>.
                </p>

                <h4>6. Cookies & Analytics</h4>
                <p>We use cookies to enhance your experience and understand how visitors use our platform.</p>

                <h4>7. Policy Updates</h4>
                <p>This privacy policy is reviewed regularly and updated when needed.</p>

                <hr class="my-4">

                <p class="small text-muted">
                    <strong>Disclaimer:</strong> This website and all its contents are part of a <strong>university student project</strong> created for educational purposes only. It is <u>not intended for commercial use</u>, <u>production deployment</u>, or any form of business operation. All product names, images, and branding are fictional or used illustratively.
                </p>
                <p class="text-center text-muted mt-3">
                    © 2025 Sport Center Victory – All Rights Reserved.
                </p>

                <p class="mt-2 text-muted text-end">
                    <em>Last updated: @DateTime.UtcNow.ToString("dd,MMMM,yyyy")</em>
                </p>
            </div>
        </div>
    </div>
</section>

