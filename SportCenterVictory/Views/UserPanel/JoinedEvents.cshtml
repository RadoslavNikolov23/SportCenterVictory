@using SCV.Web.ViewModels.CommonVM
@model IEnumerable<EventUserDetailViewModel>

@{
    ViewData["Title"] = "Joined Events ";
}

<h4 class="about_taital text-center pt-4">Joined Events</h4>

@if (Model.Count()==0)
{
    <div class="text-center" style="padding-top: 180px;">
        <h4>You have not joined any Event!</h4>
        <p class="text-muted">Join a Event to see them here.</p>
    </div>
}
else
{
    <div class="events-board">
        @foreach (var eventVM in Model)
        {
            <div class="event-card">
                @* <img src="@eventVM.ImageUrl"/> *@

                <div class="event-content">
                    <div>
                        <div class="event-title">@eventVM.Title</div>
                        <div class="event-type">@eventVM.EventType</div>
                    </div>

                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        @if (eventVM.IsUserJoined)
                        {
                            <form asp-controller="UserPanel" asp-action="RemoveEvent" method="post" class="d-inline">
                                <input type="hidden" name="eventId" value="@eventVM.EventId" />
                                <button type="submit" class="remove-button">
                                    <i class="bi bi-file-x"></i> Remove Event
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="UserPanel" asp-action="JoinEvent" method="post" class="d-inline">
                                <input type="hidden" name="eventId" value="@eventVM.EventId" />
                                <button type="submit" class="join-button">
                                    <i class="bi bi-bookmark-star"></i> Join Event
                                </button>
                            </form>
                        }
                    }
                </div>

                <div class="event-footer">
                    <div class="event-location">📍 @eventVM.Location</div>
                    <div class="event-date">@eventVM.StartDate</div>
                </div>
            </div>
        }

    </div>
}

@section Styles {
    <link href="~/css/joinedEvents.css" rel="stylesheet" />
}