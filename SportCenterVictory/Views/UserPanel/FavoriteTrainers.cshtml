            transition: transform 0.3s ease;
        }

            .trainer-card:hover {
                transform: translateY(-5px);
            }

        .trainer-img {
            flex: 0 0 100px;
            margin-right: 20px;
        }

            .trainer-img img {
                width: 100px;
                height: 100px;
                object-fit: cover;
                border-radius: 50%;
                border: 3px solid #89048E;
