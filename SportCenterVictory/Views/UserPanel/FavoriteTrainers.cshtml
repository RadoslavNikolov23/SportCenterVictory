@using SCV.Web.ViewModels.TrainerVM
@model IEnumerable<TrainerUserDetailViewModel>

@{
    ViewData["Title"] = "Favorite Trainers ";
}
@* 
<style>
        body {
            background-color: #f2f5f9;
