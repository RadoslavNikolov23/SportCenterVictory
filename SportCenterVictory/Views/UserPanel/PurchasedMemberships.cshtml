@using SCV.Web.ViewModels.CommonVM
@model IEnumerable<MembershipUserDetailViewModel>

@{
    ViewData["Title"] = "Purchased Memberships";
    var now = DateTime.UtcNow;
    var currentMemberships = Model.Where(m => m.CanBeRemoved).ToList();
    var pastMemberships = Model.Where(m => !m.CanBeRemoved).ToList();
    var expiredMemberships = Model.Where(m => m.IsExpired).ToList();
}


<h2 class="about_taital text-center pt-4 pb-4">Purchased Memberships</h2>

@if (!currentMemberships.Any() && !pastMemberships.Any() && !expiredMemberships.Any())
{
    <div class="text-center" style="padding-top: 180px;">
        <h4>You have not purchased any Membership!</h4>
        <p class="text-muted">Purchase a Membership first to see them here.</p>
    </div>
}
else
{
    <div class="pt-5">
    @if (currentMemberships.Any())
    {
        <div class="text-center mt-5 mb-3">
            <h2 class="section-title">Active Memberships (Removable within 14 days)</h2>
        </div>
        <div class="membership-container">

            @foreach (var membership in currentMemberships)
            {
                <div class="membership-card">
                    <div class="membership-title">@membership.Name</div>
                    <p class="membership-description">Purchased on: @membership.PurchasedOn</p>

                    <form asp-controller="UserPanel" asp-action="RemoveMembership" method="post" class="d-inline">
                        <input type="hidden" name="membershipId" value="@membership.MembershipId" />
                        <button type="submit" class="remove-button">
                            <i class="bi bi-file-x"></i> Remove Membership
                        </button>
                    </form>
                </div>
            }
        </div>
    }
    </div>

        <div>

    @if (pastMemberships.Any())
    {
        <div class="section-title">Past Memberships (Cannot be removed after 14 days)</div>
        <div class="membership-container">
            @foreach (var membership in pastMemberships)
            {
                <div class="membership-card">
                    <div class="membership-title">@membership.Name</div>
                    <p class="membership-description">Purchased on: @membership.PurchasedOn</p>

                    <button class="remove-button remove-disabled" disabled>
                        <i class="bi bi-lock"></i> Cannot Remove
                    </button>
                </div>
            }
        </div>
    }

    @if (expiredMemberships.Any())
    {
        <div class="section-title">Expired Memberships</div>
        <div class="membership-container">
                @foreach (var membership in expiredMemberships)
            {
                <div class="membership-card">
                    <div class="membership-title">@membership.Name</div>
                    <p class="membership-description">Purchased on: @membership.PurchasedOn</p>

                    <button class="remove-button remove-disabled" disabled>
                        <i class="bi bi-lock"></i> Expired
                    </button>
                </div>
            }
        </div>
    }
    </div>
}

@section Styles {
    <link href="~/css/purchasedMemebership.css" rel="stylesheet" />
}
