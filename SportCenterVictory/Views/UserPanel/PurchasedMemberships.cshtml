@using SCV.Web.ViewModels.CommonVM
@model IEnumerable<MembershipUserDetailViewModel>

@{
    ViewData["Title"] = "Purchased Memberships";
    var now = DateTime.UtcNow;
    var currentMemberships = Model.Where(m => m.CanBeRemoved).ToList();
    var pastMemberships = Model.Where(m => !m.CanBeRemoved && m.IsExpired).ToList();
}

