@using SCV.Web.ViewModels.CommonVM
@model IEnumerable<EventViewModel>

@{
    ViewData["Title"] = "Fitness Events ";
}


<style>
    body {
        background-color: #f0f3f9;
        font-family: 'Segoe UI', sans-serif;
    }

    .events-board {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
        gap: 25px;
        padding: 40px;
    }

    .event-card {
        position: relative;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
        background: #ffffff;
        display: flex;
        flex-direction: column;
        height: 100%;
        transition: transform 0.3s ease;
    }

        .event-card:hover {
            transform: translateY(-5px);
        }

    .event-img {
        width: 100%;
        height: 180px;
        object-fit: cover;
    }

    .event-content {
        padding: 20px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        flex: 1;
    }

    .event-title {
        font-size: 1.4rem;
        font-weight: bold;
        color: #1c1c1c;
        margin-bottom: 6px;
    }

    .event-type {
        font-size: 0.95rem;
        font-weight: 600;
        color: #007bff;
        margin-bottom: 10px;
    }

    .event-description-box {
        border: 1px dashed #ccc;
        background-color: #f9fcff;
        padding: 12px;
        border-radius: 8px;
        font-size: 0.95rem;
        color: #444;
        margin-bottom: 15px;
    }

    .event-footer {
        font-size: 0.9rem;
        color: #333;
        background-color: #f7f9fc;
        padding: 12px 15px;
        border-top: 1px solid #e3e3e3;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-radius: 0 0 15px 15px;
    }

    .event-location {
        font-weight: 600;
    }

    .event-date {
        font-style: italic;
        color: #888;
    }

    .event-placeholder {
        width: 100%;
        height: 180px;
        background: linear-gradient(135deg, #e1eaff, #cfe2ff);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        color: #007bff;
    }

    .join-button {
        align-self: flex-start;
        background-color: #28a745;
        color: white;
        font-weight: 600;
        border: none;
        padding: 10px 16px;
        border-radius: 8px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

        .join-button:hover {
            background-color: #218838;
        }
</style>

<h2 class="about_taital text-center pt-4">🏆 Upcoming Fitness Events</h2>

<div class="events-board">
    @foreach (var eventVM in Model)
    {
        <div class="event-card">
            <img src="@eventVM.ImageUrl" />

            <div class="event-content">
                <div>
                    <div class="event-title">@eventVM.Title</div>
                    <div class="event-type">@eventVM.EventType</div>
                    <div class="event-description-box">@eventVM.Description</div>
                </div>

                <button class="join-button">Join Event</button>
            </div>

            <div class="event-footer">
                <div class="event-location">📍 @eventVM.Location</div>
                <div class="event-date">@eventVM.StartDate</div>
            </div>
        </div>
    }
</div>