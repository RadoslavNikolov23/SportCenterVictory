@{
    ViewData["Title"] = "Fitness Center";
}

<div class="about_section pt-3">
    <div class="container">
        <div class="row">
            <div class="col-md-12">

                <div class="about_taital text-center">🏋️ FITNESS CENTER</div>

                <div class="row mb-4 pt-4">
                    <div class="col-md-6 pb-1">
                        <img src="https://dl.dropboxusercontent.com/scl/fi/yju1navtdbxwyiinhqtaj/fitness1.jpg?rlkey=d008yf91ra2l2wjdk19rs7zs5&st=at62htma" class="d-block w-100 rounded shadow" alt="Fitness Center1">
                    </div>
                    <br />
                    <div class="col-md-6">
                        <img src="https://dl.dropboxusercontent.com/scl/fi/lo3hgptnju9j4m682rgtp/fitness2.jpg?rlkey=r2a8wg0x39e36pw36fcs25qi2&st=r3hfjxzg" class="d-block w-100 rounded shadow" alt="Fitness Center2">
                    </div>
                </div>

                <p class="about_text text-center pt-1">
                    Our state-of-the-art <strong>Fitness Center</strong> features modern equipment, a dynamic training environment, and a team of certified personal trainers.
                    Our trainers also offer private sessions and support a community of fitness-driven individuals looking to reach their goals.
                    <br><br>
                    We provide:
                    <ul class="list-group list-group-flush text-center mx-auto" style="max-width: 600px;">
                        <li class="list-group-item">🏋️‍♂️ Strength & Cardio Equipment</li>
                        <li class="list-group-item">👨‍⚕️ Certified Nutrition Experts</li>
                        <li class="list-group-item">📋 Personalized Workout & Meal Plans</li>
                        <li class="list-group-item">📆 Regular Fitness Events</li>
                    </ul>
                    <br>
                </p>
            </div>
        </div>
    </div>
</div>
