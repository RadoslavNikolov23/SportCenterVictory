@using SCV.Web.ViewModels.CommonVM
@using SCV.GlCommon;
@model IEnumerable<MembershipDetailViewModel>

@{
    ViewData["Title"] = "Fitness Membership ";
}


<h2 class="about_taital text-center pt-4 pb-4">Our Fitness Memberships</h2>

@if (Model == null || !Model.Any())
{
    <div class="text-center" style="padding-top: 180px;">
        <p class="text-center fs-4" style="font-size: 1.5rem;">
            No Fitness Memberships are available at the moment. Please check back later.
        </p>
    </div>
}
else
{
    <div class="membership-container">
        @foreach (var membership in Model)
        {
            <div class="membership-card">
                <div class="membership-title">@membership.Name</div>

                <div class="membership-description">@membership.Description</div>

                <div class="membership-price-duration">
                    @membership.Price.ToString("C") - @membership.DurationText
                </div>

                @if ((User?.Identity?.IsAuthenticated ?? false) && User.IsInRole(RoleConstants.User))
                {
                    @if (membership.IsPurchasedMembership)
                    {

                        @if (membership.CanBeRemoved)
                        {
                            <form asp-controller="UserPanel" asp-action="RemoveMembership" method="post" class="d-inline">
                                <input type="hidden" name="membershipId" value="@membership.Id" />
                                @* <input type="hidden" name="returnUrl" value="@Url.Action("FitnessMembership", "Fitness")" /> *@
                                <button type="submit" class="remove-button">
                                    <i class="bi bi-file-x"></i> Remove Membership
                                </button>
                            </form>
                        }
                        else if (membership.IsExpired)
                        {
                            <form asp-controller="UserPanel" asp-action="JoinMembership" method="post" class="d-inline">
                                <input type="hidden" name="membershipId" value="@membership.Id" />
                                @* <input type="hidden" name="returnUrl" value="@Url.Action("FitnessMembership", "Fitness")" /> *@
                                <button type="submit" class="buy-button">
                                    <i class="bi bi-bookmark-star"></i> Buy Membership
                                </button>
                            </form>
                        }

                    }
                    else
                    {

                        <form asp-controller="UserPanel" asp-action="JoinMembership" method="post" class="d-inline">
                            <input type="hidden" name="membershipId" value="@membership.Id" />
                            <button type="submit" class="buy-button">
                                <i class="bi bi-bookmark-star"></i> Buy Membership
                            </button>
                        </form>

                    }
                }
            </div>
        }
    </div>
}

@section Styles {
    <link href="~/css/fitnessMembership.css" rel="stylesheet" />
}

