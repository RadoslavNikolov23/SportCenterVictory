@using SCV.Web.ViewModels.FitnessVM

@model ICollection<ExercisesDetailViewModel>

@{
    ViewData["Title"] = "Exercises ";
}


@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        @ViewBag.Message ?? "No exercises available on this page."
    </div>
}
else
{
    <div class="row text-center layout_padding">
        <h1 class="about_taital text-center">Exercise Library</h1>
        <input type="text" id="search" placeholder="Search exercises..." class="form-control mb-3" />

        <div class="row mb-4" id="exercise-list">
            @await Html.PartialAsync("_ExercisePartial", Model)
        </div>

        <div class="about_taital text-center mt-1 pt-2">
            <button id="load-more-btn" class="btn btn-primary" style="width: 250px; height: 50px;">Load More</button>
        </div>
    </div>
}

@section Styles {
    <link href="~/css/exerciseTwo.css" rel="stylesheet" />
}

@section Scripts {
    <script>
        let currentPage = @ViewBag.CurrentPage;
        const pageSize = @ViewBag.PageSize;
    </script>
    <script src="~/js/exerciseTwo.js"></script>
}