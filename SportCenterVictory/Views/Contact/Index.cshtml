@using SCV.Web.ViewModels.ContactVM;
@model ContactFormViewModel

@{
    ViewData["Title"] = "Contacts";
}

<div class="contact_section layout_padding">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="mail_section_1">
                    <h1 class="contact_taital">Get In Touch</h1>
                    <form asp-action="Index" method="post">
                        <input asp-for="Name" class="mail_text" placeholder="Name" />
                        <span asp-validation-for="Name" class="text-danger"></span>

                        <input asp-for="Email" class="mail_text" placeholder="Email" />
                        <span asp-validation-for="Email" class="text-danger"></span>

                        <input asp-for="PhoneNumber" class="mail_text" placeholder="Phone Number" />
                        <textarea asp-for="Message" class="massage-bt" placeholder="Message" rows="5"></textarea>
                        <span asp-validation-for="Message" class="text-danger"></span>

                        <div class="send_bt">
                            <button type="submit" class="btn btn-primary">Send</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="col-md-6 padding_right_0">
                <div class="contact_img">
                    <img src="https://dl.dropboxusercontent.com/scl/fi/xnnlbjf5k56fa5ffmifzj/getInTouch.jpg?rlkey=bqcf78pp7jxrgvniqr1fxabjo&st=ea31uhgu" />
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
