@using SVC.Web.ViewModels.StoreVM
@model IEnumerable<StoreProductViewModel>

@{
    ViewData["Title"] = "Store - Nutrition ";
}

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Segoe UI', sans-serif;
    }

    .store-container {
        padding: 40px;
    }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 30px;
    }

    .product-card {
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.06);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.2s ease-in-out;
    }

        .product-card:hover {
            transform: translateY(-5px);
        }

    .product-image {
        width: 100%;
        height: 180px;
        object-fit: cover;
    }

    .product-content {
        padding: 16px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .product-title {
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .product-category {
        font-size: 0.9rem;
        color: #777;
        margin-bottom: 10px;
    }

    .product-description {
        flex-grow: 1;
        font-size: 0.95rem;
        color: #444;
        margin-bottom: 10px;
    }

    .product-price {
        font-size: 1.1rem;
        font-weight: bold;
        color: #6DBD14;
        margin-bottom: 12px;
    }

    .quantity-buy {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

        .quantity-buy input {
            width: 60px;
        }

    .btn-buy {
        background-color: #6DBD14;
        color: #fff;
        font-weight: 600;
        border: none;
        padding: 6px 12px;
        border-radius: 6px;
        transition: background-color 0.3s ease;
    }

        .btn-buy:hover {
            background-color: #197208;
        }
</style>

<div class="about_section layout_padding pt-2">

<div class="store-container">
    <h2 class="text-center mb-5">🏋️‍♀️ Welcome to the Sport Center Victory Store for Nutrition</h2>

    <div class="product-grid">
        @foreach (var product in Model)
        {
            <div class="product-card">
                <img src="@product.ImageUrl" alt="@product.Title" class="product-image" />

                <div class="product-content">
                    <div class="product-title">@product.Title</div>
                    <div class="product-category">@product.ProductCategory</div>

                    @if (!string.IsNullOrWhiteSpace(product.Description))
                    {
                        <div class="product-description">@product.Description</div>
                    }

                    <div class="product-price">@product.Price.ToString("C")</div>

                    <div class="quantity-buy">
                        <input type="number" min="1" max="@product.Quantity" value="1" class="form-control" />
                        <button class="btn-buy" data-id="@product.Id">Buy</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
</div>