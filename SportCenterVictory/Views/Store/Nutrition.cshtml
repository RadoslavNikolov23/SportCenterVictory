@using SVC.Web.ViewModels.StoreVM
@model IEnumerable<StoreProductViewModel>

@{
    ViewData["Title"] = "Store - Nutrition ";
}

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Segoe UI', sans-serif;
    }

    .store-container {
        padding: 40px;
    }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 30px;
    }

    .product-card {
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.06);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.2s ease-in-out;
    }

        .product-card:hover {
            transform: translateY(-5px);
        }

    .product-image {
        width: 100%;
        height: 180px;
        object-fit: cover;
    }

    .product-content {
        padding: 16px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .product-title {
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .product-category {
        font-size: 0.9rem;
        color: #777;
        margin-bottom: 10px;
    }

    .product-description {
        flex-grow: 1;
        font-size: 0.95rem;
        color: #444;
        margin-bottom: 10px;
    }

    .product-price {
        font-size: 1.1rem;
        font-weight: bold;
        color: #6DBD14;
        margin-bottom: 12px;
    }

    .quantity-buy {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

        .quantity-buy input {
            width: 60px;
        }

    .btn-buy {
        background-color: #6DBD14;
        color: #fff;
        font-weight: 600;
        border: none;
        padding: 6px 12px;
        border-radius: 6px;
        transition: background-color 0.3s ease;
    }

        .btn-buy:hover {
            background-color: #197208;
        }
</style>

<div class="about_section layout_padding pt-2">

    <div class="store-container">
        <h1 class="text-center mb-3" style="font-size: 2.5rem;">Welcome to the Sport Center Victory Store for Nutrition</h1>

        <div style="display: flex; justify-content: flex-end; margin-bottom: 1rem;">
            <a href="/Store/Cart" class="btn btn-primary btn-lg">
                Go to Cart
            </a>
        </div>

        <div class="product-grid">
            @foreach (var product in Model)
            {
                <div class="product-card">
                    <img src="@product.ImageUrl" alt="@product.Title" class="product-image" />

                    <div class="product-content">
                        <div class="product-title">@product.Title</div>
                        <div class="product-category">@product.ProductCategory</div>

                        @if (!string.IsNullOrWhiteSpace(product.Description))
                        {
                            <div class="product-description">@product.Description</div>
                        }

                        <div class="product-price">@product.Price.ToString("C")</div>

                        <form asp-controller="Store" asp-action="AddToCart" method="post" class="quantity-buy">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@product.Id" />
                            <input type="number" name="quantity" min="1" max="@product.Quantity" value="1" class="form-control" />
                            <button type="submit" class="btn-buy">Buy</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Attach to all forms with class quantity-buy
        document.querySelectorAll('form.quantity-buy').forEach(form => {
            form.addEventListener('submit', async function (e) {
                e.preventDefault(); // stop normal form submission

                const formData = new FormData(this);
                const token = formData.get('__RequestVerificationToken');

                try {
                    const response = await fetch(this.action, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token
                        },
                        body: formData
                    });

                    if (response.ok) {
                        toastr.success('Product added to cart!');
                        // Optionally reset quantity input
                        this.querySelector('input[name="quantity"]').value = 1;
                    } else {
                        toastr.error('Failed to add product to cart.');
                    }
                } catch (error) {
                    toastr.error('An error occurred.');
                    console.error(error);
                }
            });
        });
    </script>
}

