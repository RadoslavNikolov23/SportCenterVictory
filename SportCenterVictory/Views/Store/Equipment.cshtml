@using SVC.Web.ViewModels.StoreVM
@model IEnumerable<StoreProductViewModel>

@{
    ViewData["Title"] = "Store - Equipment ";
}

<div class="about_section layout_padding pt-2">
    <div class="store-container">
        <h2 class="text-center mb-3" style="font-size: 2.5rem;">Welcome to the Sport Center Victory Store for Equipment</h2>

        <div style="display: flex; justify-content: flex-end; margin-bottom: 1rem;">
            <a href="/Store/Cart" class="btn btn-primary btn-lg">
                Go to Cart
            </a>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="text-center" style="padding-top: 180px;">
                <p class="text-center fs-4" style="font-size: 1.5rem;">
                    No Equipment Products are available at the moment. Please check back later.
                </p>
            </div>

        }
        else
        {
            <div class="product-grid">
                @foreach (var product in Model)
                {
                    <div class="product-card">
                        <img src="@product.ImageUrl" alt="@product.Title" class="product-image" />

                        <div class="product-content">
                            <div class="product-title">@product.Title</div>
                            <div class="product-category">@product.ProductCategory</div>

                            @if (!string.IsNullOrWhiteSpace(product.Description))
                            {
                                <div class="product-description">@product.Description</div>
                            }

                            <div class="product-price">@product.Price.ToString("C")</div>

                            <form asp-controller="Store" asp-action="AddToCart" method="post" class="quantity-buy">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@product.Id" />
                                <input type="number" name="quantity" min="1" max="@product.Quantity" value="1" class="form-control" />
                                <button type="submit" class="btn-buy">Buy</button>
                            </form>

                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>


@section Styles {
    <link href="~/css/equipment-product.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/js/equipment-product.js"></script>
}