@{
    ViewData["Title"] = "Powerlifting Center";
}

<div class="about_section pt-3">
    <div class="container">
        <div class="row">
            <div class="col-md-12">

                <div class="about_taital text-center">💪 POWERLIFTING ZONE</div>

                <div class="row mb-4 pt-4">
                    <div class="col-md-6 pb-1">
                        <img src="https://dl.dropboxusercontent.com/scl/fi/4v4dhn0gm15fe5gdmevus/powerlifting1.jpg?rlkey=cyypuijiwyt0xeohhdm6p5zvb&st=136bzi7d" class="d-block w-100 rounded shadow" alt="Powerlifting Zone1">
                    </div>
                    <br />
                    <div class="col-md-6">
                        <img src="https://dl.dropboxusercontent.com/scl/fi/hvbdjivkkuroev24rxnlm/powerlifting2.jpg?rlkey=mk21fge7b68rs6x5f7exspzm8&st=s5pj6bd6" class="d-block w-100 rounded shadow" alt="Powerlifting Zone2">
                    </div>
                </div>

                <p class="about_text text-center pt-1">
                    Our <strong>Powerlifting Zone</strong> is built for strength athletes who want to push their PRs and compete with purpose.
                    From deadlifts to squats to bench press — we are here to support lifters of all levels in becoming stronger, smarter, and more focused.
                    <br><br>
                    We provide:
                        <ul class="list-group list-group-flush text-center mx-auto" style="max-width: 600px;">
                            <li class="list-group-item">🏋️‍♀️ Competition-Grade Equipment</li>
                            <li class="list-group-item">💪 One-on-One Coaching</li>
                            <li class="list-group-item">📓 Strength-Focused Training Plans</li>
                            <li class="list-group-item">🏆 Powerlifting Meets & Events</li>
                        </ul>
                    <br>
                </p>
            </div>
        </div>
    </div>
</div>
