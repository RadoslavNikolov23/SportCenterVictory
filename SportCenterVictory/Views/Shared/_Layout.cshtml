<!DOCTYPE html>
<html lang="en">
<head>

    <!-- basic -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    @* <!-- mobile metas -->
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="viewport" content="initial-scale=1, maximum-scale=1">
    <!-- site metas -->
    <meta name="keywords" content="">
    <meta name="description" content="">
    <meta name="author" content=""> *@

    <title>@ViewData["Title"]Sport Center Victory</title>


    <!-- Bootstrap CSS -->
    @* <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"> *@

    <!-- FontAwesome -->
    @* <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"> *@

    <!-- Owl Carousel -->
    @* <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" /> *@

    <!-- NiceSelect -->
    @* <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-nice-select/1.1.0/css/nice-select.min.css" /> *@



    <!-- bootstrap css -->
    <link rel="stylesheet" href="~/css/bootstrap.css">
    <link rel="stylesheet" href="~/css/site.css">
    <link rel="stylesheet" href="~/css/style.css" />
    <link rel="stylesheet" href="~/css/font-awesome.min.css" />

    <!-- Custom and Component Styles -->
    <link rel="stylesheet" href="~/css/responsive.css" />

    <!-- Scrollbar Custom CSS -->
    <link rel="stylesheet" href="~/css/jquery.mCustomScrollbar.min.css">

    <link rel="stylesheet" href="https://netdna.bootstrapcdn.com/font-awesome/4.0.3/css/font-awesome.css">

    <!-- Optional (if you're using Swiper and it's available) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

    <!-- Google Fonts -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&family=Raleway:wght@400;500;600;700;800&display=swap">
</head>

<body>
    <header>

        <div class="header_section">

            <div class="container">
                <nav class="navbar navbar-expand-lg navbar-light bg-light">

                    <a class="nav-link" asp-controller="Home" asp-action="Index"><img src="https://dl.dropboxusercontent.com/scl/fi/8bre7y8sq2f34twy1lyoy/SVC-logo.png?rlkey=qgkxix7gktkpd956t29v9dvjb&st=qsv5ibog" class="img-fluid" style="width: 300px;" alt="Logo"></a>

                    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="navbar-nav ml-auto">

                            @await Html.PartialAsync("_AdministrativeMenuPartial")

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="fitnessDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    Fitness
                                </a>
                                <div class="dropdown-menu" aria-labelledby="fitnessDropdown">
                                    <a class="dropdown-item" asp-controller="Fitness" asp-action="FitnessCenter">Fitness Center</a>
                                    <a class="dropdown-item" asp-controller="Fitness" asp-action="FitnessTrainer">Trainers</a>
                                    <a class="dropdown-item" asp-controller="Fitness" asp-action="FitnessMembership">Membership </a>
                                    <a class="dropdown-item" asp-controller="Fitness" asp-action="WorkoutPlans">Workout Plans</a>
                                    <a class="dropdown-item" asp-controller="Fitness" asp-action="Exercises">Exercises</a>
                                    <a class="dropdown-item" asp-controller="Fitness" asp-action="FitnessEvents">Fitness Events</a>
                                </div>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="crossfitDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    CrossFit
                                </a>
                                <div class="dropdown-menu" aria-labelledby="crossfitDropdown">
                                    <a class="dropdown-item" asp-controller="CrossFit" asp-action="CrossFitArena">CrossFit Arena</a>
                                    <a class="dropdown-item" asp-controller="CrossFit" asp-action="CrossFitCoaches">Coaches</a>
                                    <a class="dropdown-item" asp-controller="CrossFit" asp-action="CrossFitMembership">Membership </a>
                                    <a class="dropdown-item" asp-controller="CrossFit" asp-action="CrossFitClasses">CrossFit Classes</a>
                                    <a class="dropdown-item" asp-controller="CrossFit" asp-action="CrossFitWOD">Workout of The Day</a>
                                    <a class="dropdown-item" asp-controller="CrossFit" asp-action="CrossFitEvents">CrossFit Events</a>
                                </div>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="powerliftingDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    Powerlifting
                                </a>
                                <div class="dropdown-menu" aria-labelledby="powerliftingDropdown">
                                    <a class="dropdown-item" asp-controller="Powerlifting" asp-action="PowerliftingZone">Powerlifting Zone</a>
                                    <a class="dropdown-item" asp-controller="Powerlifting" asp-action="PowerliftingCoaches">Coaches</a>
                                    <a class="dropdown-item" asp-controller="Powerlifting" asp-action="PowerliftingMembership">Membership</a>
                                    <a class="dropdown-item" asp-controller="Powerlifting" asp-action="PowerliftingEvents">Powerlifting Events</a>
                                </div>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="storeDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    Store
                                </a>
                                <div class="dropdown-menu" aria-labelledby="storeDropdown">
                                    <a class="dropdown-item" asp-controller="Store" asp-action="Equipment">Equipment</a>
                                    <a class="dropdown-item" asp-controller="Store" asp-action="Nutrition">Nutrition</a>
                                    <a class="dropdown-item" asp-controller="Store" asp-action="Memberships">Memberships</a>
                                </div>
                            </li>


                            @*  Put here hidden content for admin, moderator, trainers
                            <li class="nav-item">
                            <a class="nav-link" asp-controller="About" asp-action="Index">
                                About
                            </a>
                        </li> 

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Contact" asp-action="Index">
                                Contact
                            </a>
                        </li> *@


                            <li class="nav-item dropdown">
                                <a class="nav-link" href="@Url.Action("Search", "Home")">
                                    @* <i class="fas fa-search" style="font-size: 24px;"></i> <!-- Search Icon --> *@
                                    Search
                                </a>
                            </li>

                            @* <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    Account
                                </a> *@
                            <partial name="_LoginPartial" />
                            @* </li> *@

                        </ul>



                    </div>
                </nav>
            </div>
        </div>
    </header>
    <!-- header section end -->

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    <footer class="border-top footer text-muted">
        <!-- footer section start -->
        <div class="footer_section layout_padding">
            <div class="container">
                <div class="row">

                    <div class="col-lg-3 col-sm-6 align-content-center">
                        <div class="footer_logo"><img src="https://dl.dropboxusercontent.com/scl/fi/aftk02fz76np0t6360z6j/footer-logo.png?rlkey=afiwuz8ciclyglhlx0bdxl3zp&st=fg178pag"></div>
                        <p class="footer_text">"Your Journey. Your Rules. Your Victory."</p>
                    </div>

                    <div class="col-lg-3 col-sm-6">
                        <h1 class="useful_text">
                            Motivational Quotes
                        </h1>
                        <p class="footer_text">The pain you feel today will be the strength you feel tomorrow - <i>Arnold Schwarzenegger</i> </p>
                    </div>

                    <div class="col-lg-3 col-sm-6 pl-5">
                        <h3 class="useful_text">Useful Links</h3>
                        <div class="footer_menu">
                            <ul>
                                <li><a asp-area="" asp-controller="About" asp-action="Index">About</a></li>
                                <li><a asp-area="" asp-controller="Contact" asp-action="Index">Contact</a></li>
                                <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                                <li><a asp-area="" asp-controller="Store" asp-action="Index">Store</a></li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-lg-3 col-sm-6">
                        <h1 class="useful_text">Contact Us</h1>
                        <div class="location_text">
                            <ul>
                                <li>
                                    <i class="fa fa-map-marker" aria-hidden="true"></i><span class="padding_left_10">bul. Botev, Ruse Bulgaria</span>
                                </li>
                                <li>
                                    <i class="fa fa-phone" aria-hidden="true"></i><span class="padding_left_10">Call : +359 888 433 131</span>
                                </li>
                                <li>
                                    <i class="fa fa-envelope" aria-hidden="true"></i><span class="padding_left_10">Email : custom_rd@abv.bg</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="social_icon">
                    <ul>
                        <li><a href="https://www.facebook.com/"><i class="fa fa-facebook" aria-hidden="true"></i></a></li>
                        <li><a href="https://www.instagram.com/"><i class="fa fa-instagram" aria-hidden="true"></i></a></li>
                        <li><a href="https://www.youtube.com/"><i class="fa fa-youtube-play" aria-hidden="true"></i></a></li>
                        <li><a href="https://www.linkedin.com/"><i class="fa fa-linkedin" aria-hidden="true"></i></a></li>
                    </ul>
                </div>

            </div>
        </div>
        <!-- footer section end -->
    </footer>

    <!-- Javascript files-->
    <script src="~/js/jquery.min.js"></script>
    @* <script src="~/js/jquery-3.5.1.min.js"></script> *@
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/plugin.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.slim.min.js"></script>
   

    <!-- sidebar -->
    <script src="~/js/jquery.mCustomScrollbar.concat.min.js"></script>
    <script src="~/js/custom.js"></script>



    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
