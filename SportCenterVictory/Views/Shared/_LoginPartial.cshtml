@using Microsoft.AspNetCore.Identity
@using SCV.Data.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    string emailUser = User.Identity?.Name!;
    string nameUser = !string.IsNullOrEmpty(emailUser) ? emailUser.Split('@')[0] : "Guest";

    IList<string>? roles = SignInManager.IsSignedIn(User)
        ? await UserManager.GetRolesAsync(await UserManager.GetUserAsync(User))
        : new List<string>();
}

<li class="nav-item dropdown position-relative">
    <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        Account
    </a>

    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">

        @if (SignInManager.IsSignedIn(User))
        {
            <li><h6 class="dropdown-header">Hello, @nameUser!</h6></li>

            @if (roles.Contains("User"))
            {
                <li><a class="dropdown-item" asp-area="" asp-controller="UserPanel" asp-action="LeaveFeedback">Leave Feedback</a></li>
                <li><a class="dropdown-item" asp-area="" asp-controller="UserPanel" asp-action="JoinedCrossfitClasses">Joined CrossFit Classes</a></li>
                <li><a class="dropdown-item" asp-area="" asp-controller="UserPanel" asp-action="JoinedEvents">Joined Events</a></li>
                <li><a class="dropdown-item" asp-area="" asp-controller="UserPanel" asp-action="FavoriteTrainers">Favorite Trainers</a></li>
                <li><a class="dropdown-item" asp-area="" asp-controller="UserPanel" asp-action="PurchasedMemberships">My Memberships</a></li>
                <li><a class="dropdown-item" asp-area="" asp-controller="UserPanel" asp-action="MadeOrders">My Orders</a></li>
            }

            else if (roles.Contains("Trainer"))
            {
                <li><a class="dropdown-item" asp-area="" asp-controller="TrainerPanel" asp-action="UserClientList">Client List</a></li>
                <li><a class="dropdown-item" asp-area="" asp-controller="UserPanel" asp-action="JoinedEvents">Joined Events</a></li>
            }

            else if (roles.Contains("Admin") || roles.Contains("Manager"))
            {
                <li><a class="dropdown-item" asp-area="Administration" asp-controller="Crossfit" asp-action="UsersJoinedCrossfitClass">CrossFit Classes & Users</a></li>
                <li><a class="dropdown-item" asp-area="Administration" asp-controller="Store" asp-action="UsersPurchasedMemberships">Memberships & Users</a></li>
                <li><a class="dropdown-item" asp-area="Administration" asp-controller="Event" asp-action="EventsAndClients">Events & Users</a></li>
                <li><a class="dropdown-item" asp-area="Administration" asp-controller="Trainer" asp-action="TrainersAndClients">Trainers & Clients</a></li>
                <li><a class="dropdown-item" asp-area="Administration" asp-controller="Store" asp-action="AllOrders">All Orders & Users</a></li>
            }

            <li><hr class="dropdown-divider" /></li>

            <li>
                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">Manage Profile</a>
                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/ChangePassword">Change Password</a>
            </li>
            <li>
                <form class="dropdown-item p-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post">
                    <button type="submit" class="btn btn-link dropdown-item">Logout</button>
                </form>
            </li>
        }
        else
        {
            <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Login">Login</a></li>
            <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Register">Register</a></li>
        }
    </ul>
</li>

