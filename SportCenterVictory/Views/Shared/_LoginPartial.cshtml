@using Microsoft.AspNetCore.Identity
@using SCV.Data.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@* <li class="nav-item dropdown"> *@

@{
    string emailUser = User.Identity?.Name!;
    string nameUser = !string.IsNullOrEmpty(emailUser) ? emailUser.Split('@')[0] : "Guest";

    var roles = SignInManager.IsSignedIn(User)
        ? await UserManager.GetRolesAsync(await UserManager.GetUserAsync(User))
        : new List<string>();
}

<li class="nav-item dropdown position-relative">
    <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        Account
    </a>

    <!-- Dropdown Menu (contains _LoginPartial) -->
    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">

        @if (SignInManager.IsSignedIn(User))
        {
            <li><h6 class="dropdown-header">Hello, @nameUser!</h6></li>

            @* === USER ROLE === *@
            @if (roles.Contains("User"))
            {
                <li><a class="dropdown-item" asp-controller="Feedback" asp-action="Leave">Leave Feedback</a></li>
                <li><a class="dropdown-item" asp-controller="CrossfitClass" asp-action="Available">Join CrossFit Classes</a></li>
                <li><a class="dropdown-item" asp-controller="Trainer" asp-action="Favorites">Favorite Trainers</a></li>
                <li><a class="dropdown-item" asp-controller="Order" asp-action="MyOrders">My Orders</a></li>
                <li><a class="dropdown-item" asp-controller="Membership" asp-action="MyMemberships">My Memberships</a></li>
            }

            @* === TRAINER ROLE === *@
            else if (roles.Contains("Trainer"))
            {
                <li><a class="dropdown-item" asp-controller="User" asp-action="List">User List</a></li>
                <li><a class="dropdown-item" asp-controller="TrainerFavorites" asp-action="Add">Add User to Favorites</a></li>
            }

            @* === ADMIN/MANAGER === *@
            else if (roles.Contains("Admin") || roles.Contains("Manager"))
            {
                <li><a class="dropdown-item" asp-controller="CrossfitClass" asp-action="ListWithUsers">CrossFit Classes & Users</a></li>
                <li><a class="dropdown-item" asp-controller="Membership" asp-action="ListWithUsers">Memberships & Users</a></li>
                <li><a class="dropdown-item" asp-controller="Trainer" asp-action="ListWithUsers">Trainers & Users</a></li>
                <li><a class="dropdown-item" asp-controller="Order" asp-action="ListWithUsers">Orders & Users</a></li>
            }

            <li><hr class="dropdown-divider" /></li>

            <li>
                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">Manage Profile</a>
            </li>
            <li>
                <form class="dropdown-item p-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post">
                    <button type="submit" class="btn btn-link dropdown-item">Logout</button>
                </form>
            </li>
        }
        else
        {
            <!-- Guest options -->
            <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Login">Login</a></li>
            <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Register">Register</a></li>
        }
    </ul>
</li>
@* </li> *@

