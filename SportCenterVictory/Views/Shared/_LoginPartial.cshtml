@using Microsoft.AspNetCore.Identity
@using SCV.Data.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@* <li class="nav-item dropdown"> *@

@{
    string emailUser = User.Identity?.Name!;
    string nameUser = !string.IsNullOrEmpty(emailUser) ? emailUser.Split('@')[0] : "Guest";
}

<li class="nav-item dropdown">
    <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        Account
    </a>

    <!-- Dropdown Menu (contains _LoginPartial) -->
    <div class="dropdown-menu" aria-labelledby="userDropdown">

        @if (SignInManager.IsSignedIn(User))
        {
            
            <!-- When user is signed in -->
            <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Hello @nameUser</a>
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="dropdown-item">Logout</button>

            </form>
        }
        else
        {
            <!-- When user is not signed in-->
            <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Register">Register</a>
            <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Login">Login</a>
        }
    </div>
</li>
@* </li> *@

